{
  "rewrites": [
    { "source": "/BMCE", "destination": "/bmce/index.html" },
    { "source": "/BMCE/", "destination": "/bmce/index.html" },
    { "source": "/Bmce", "destination": "/bmce/index.html" },
    { "source": "/bmce", "destination": "/bmce/index.html" },
    { "source": "/((?!assets/|api/|bmce/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/bmce/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
